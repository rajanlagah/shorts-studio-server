# Supabase SESSION pooler (port 5432), not transaction pooler.
# Use the shorts_backend password from api/bootstrap.sql; URL-encode it.
DATABASE_URL=postgresql://shorts_backend.qouxgohmtnfudzqgtrdp:iNhzWxy84F6mmL1bvQ6HXHZWc0ZPmf@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=no-verify

# Use the SAME absolute directory in api/.env and worker/.env.
# Replace YOUR_USER with your Droplet user and create this directory.
DATA_DIR=/home/YOUR_USER/shorts-data

# PM2 deployment behind local Nginx; do not expose port 3001 publicly.
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=true

# Exact frontend origins, comma-separated, without trailing slashes.
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# Optional provider CA: use an absolute path on the Droplet.
# If needed, remove sslmode from DATABASE_URL before enabling this.
# PG_CA_FILE=/home/YOUR_USER/certs/supabase-ca.crt

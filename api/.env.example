# Use Supabase direct connection or SESSION pooler (port 5432).
# Set password for shorts_backend in api/schema.sql. URL-encode special characters.
# For Supabase session pooler, username is shorts_backend.PROJECT_REF.
# sslmode=verify-full enables certificate validation; provide provider CA if needed.
DATABASE_URL=postgresql://shorts_backend.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# Optional CA path INSIDE container. Mount the provider CA before setting this.
# PG_CA_FILE=/certs/supabase-ca.crt
DATA_DIR=/data
PORT=3001
CORS_ORIGINS=http://localhost:3000
# Enable ONLY behind the included Caddy proxy; never expose API port publicly.
TRUST_PROXY=true
API_HOST=api.example.com
# Worker only; blank disables automatic captions. Manual captions still work.
OPENAI_API_KEY=
# OAuth client ID from Google Cloud Console (Web application type).
# Must match the client ID the frontend uses to request Google ID tokens.
GOOGLE_CLIENT_ID=
# Object storage (plan 013): any S3-compatible service; Backblaze B2 in
# production. Private bucket; key restricted to this bucket. Unset = project
# uploads/exports return 503 (legacy session uploads still work).
STORAGE_PROVIDER=b2
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=shortmonk-media-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for MinIO-style local servers.
# S3_FORCE_PATH_STYLE=true

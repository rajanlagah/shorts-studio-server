# Supabase admin connection, used ONLY by the migration command.
# Use direct connection or SESSION pooler on port 5432.
# This is the postgres database password, not your shorts_backend password.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_ADMIN_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# Optional provider CA; remove sslmode from the URL when enabling this.
# MIGRATION_PG_CA_FILE=/absolute/path/to/supabase-ca.crt
